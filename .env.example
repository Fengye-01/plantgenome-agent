# ============================================================
# PlantGenome Agent 配置文件模板
# 使用方法：复制本文件为 .env，然后填入实际值
#   cp .env.example .env
# ============================================================

# ────────────────────────────────────────────────────────────
# LLM 配置（支持 OpenAI 兼容格式的 API）
# ────────────────────────────────────────────────────────────

# 模型 ID（硅基流动示例）
LLM_MODEL_ID="Qwen/Qwen2.5-7B-Instruct"

# API Key（填入你的 key）
LLM_API_KEY="sk-your-api-key-here"

# API Base URL（硅基流动：https://api.siliconflow.cn/v1）
# 其他 OpenAI 兼容平台：修改为对应地址
LLM_BASE_URL="https://api.siliconflow.cn/v1"

# 请求超时（秒）
LLM_TIMEOUT=120

# ────────────────────────────────────────────────────────────
# 向量数据库配置
# ────────────────────────────────────────────────────────────

# Chroma 持久化目录（相对项目根目录）
CHROMA_PERSIST_DIR="data/chroma"

# Embedding 模型（BGE-m3 支持中英文混合，对生物专有名词支持好）
EMBEDDING_MODEL="BAAI/bge-m3"

# ────────────────────────────────────────────────────────────
# RAG 参数
# ────────────────────────────────────────────────────────────

# 分块大小（token 数，用 BGE-m3 tokenizer 精确计算）
CHUNK_SIZE=600

# 分块重叠（token 数）
CHUNK_OVERLAP=50

# 检索 Top-K（返回最相关的 K 个文档块）
RETRIEVE_TOP_K=3
RAG_MAX_DISTANCE=0.8

# ────────────────────────────────────────────────────────────
# 数据库配置（PostgreSQL）
# ────────────────────────────────────────────────────────────

# 数据库连接 URL
# 格式: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL="postgresql+psycopg2://plantgenome:plantgenome@localhost:5432/plantgenome"

# ────────────────────────────────────────────────────────────
# Redis 配置（异步任务队列）
# ────────────────────────────────────────────────────────────

# Redis 连接 URL
# 格式: redis://:password@host:port/db
REDIS_URL="redis://localhost:6379/0"

# ────────────────────────────────────────────────────────────
# JWT / 安全配置
# ────────────────────────────────────────────────────────────

# JWT 密钥（生产环境务必修改为随机字符串）
SECRET_KEY="plantgenome-agent-secret-key-change-in-production"

# JWT 算法
JWT_ALGORITHM="HS256"

# 访问令牌过期时间（分钟），默认 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ────────────────────────────────────────────────────────────
# 应用配置
# ────────────────────────────────────────────────────────────

# FastAPI 服务地址
APP_HOST="0.0.0.0"

# FastAPI 服务端口
APP_PORT=8000

# ────────────────────────────────────────────────────────────
# HuggingFace 镜像（国内用户建议设置，加速模型下载）
# 在终端中设置：$env:HF_ENDPOINT = "https://hf-mirror.com"
# 或在 .env 中设置（需要 python-dotenv 支持）
# ────────────────────────────────────────────────────────────
# HF_ENDPOINT="https://hf-mirror.com"
